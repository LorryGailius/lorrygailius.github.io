---
import { Image } from "astro:assets";
import Card from "./Card/index.astro";

const { projects, title } = Astro.props;
---

<Card title={title} colSpan="sm:col-span-3 sm:max-h-[600px] h-fit" backgroundColor="bg-neobrutalism-lime dark:bg-neobrutalism-purple">
  <div class="sm:overflow-y-auto overflow-x-visible sm:max-h-[32rem] p-2">
    {
      projects.map((project: any) => (
        <div>
          <div class="flex flex-row gap-5 mt-5 sm:pr-5">
            <a href={project.data.link} class="hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px] hover:shadow-neobrutalism-black transition-all duration-200 border-3 border-neobrutalism-black">
              <Image
                width={100}
                height={100}
                src={project.data.image}
                alt={`${project.data.title} logo`}
                class="max-w-24 max-h-24"
              />
            </a>
            <div class="text-wrap">
              <a href={project.data.link}>
                <h1 class="font-black text-xl hover:underline hover:underline-offset-4 hover:decoration-4 hover:decoration-neobrutalism-red text-neobrutalism-black">
                  {project.data.title}
                </h1>
              </a>
              <p class="font-bold text-neobrutalism-black">
                {project.data.description}
              </p>
            </div>
          </div>
          {project.data.tags.map((tag: string) => (
            <span class="inline-block px-3 py-1 mt-3 mr-3 text-sm font-black text-neobrutalism-black bg-neobrutalism-lime border-2 border-neobrutalism-black shadow-[3px_3px_0px_0px] shadow-neobrutalism-black select-none uppercase">
              {tag}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</Card>
