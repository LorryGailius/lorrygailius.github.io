---
interface Props {
  title?: string;
  body?: string;
}

const { title, body } = Astro.props;
---

<>
  {title && <h2 class="text-2xl font-black m-0 text-neobrutalism-black uppercase tracking-wide">{title}</h2>}
  {body && <p class="m-0 font-bold text-base text-neobrutalism-black">{body}</p>}
  <slot />
</>
