---
import Avatar from "./Avatar.astro";
import Card from "./Card/index.astro";
---

<Card
  colSpan="md:col-span-2 items-center"
  rowSpan="md:row-span-1 h-fit sm:h-auto flex justify-center"
  backgroundColor="bg-neobrutalism-cyan dark:bg-neobrutalism-lime"
>
  <div>
    <div class="float-right h-full sm:h-auto">
      <Avatar />
    </div>
    <p class="m-0 font-black text-xl text-neobrutalism-black">
      Hello, I'm <br class="inline sm:hidden" />
      <b class="font-black text-2xl">Laurynas Gailius</b>,<br /> a beginner software engineer
      looking to find his way in the world of programming.
    </p>
  </div>
</Card>
