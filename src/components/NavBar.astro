---
import NavCard from "./Card/NavCard.astro";
import Sandwich from "./Sandwich.astro";
import ThemeToggle from "./ThemeToggle.astro";

const btnStyle =
  "py-3 px-4 sm:py-2 sm:px-4 bg-neobrutalism-white dark:bg-neobrutalism-cyan hover:bg-neobrutalism-lime dark:hover:bg-neobrutalism-yellow text-neobrutalism-black font-bold border-2 border-neobrutalism-black hover:shadow-[4px_4px_0px_0px] hover:shadow-neobrutalism-black transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1";

const active = "!bg-neobrutalism-yellow dark:!bg-neobrutalism-orange !shadow-[4px_4px_0px_0px] !shadow-neobrutalism-black !-translate-x-1 !-translate-y-1";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\//g, "");
---

<NavCard>
  <div class="hidden sm:flex flex-row items-center">
    <a class={`${btnStyle} ${currentPath === "" ? active : ""}`} href="/"
      >Home</a
    >
    <a
      class={`${btnStyle} ${currentPath === "about" ? active : ""}`}
      href="/about">About</a
    >
    <a
      class={`${btnStyle} ${currentPath === "projects" ? active : ""}`}
      href="/projects">Projects</a
    >
    <a
      class={`${btnStyle} ${currentPath === "contact" ? active : ""}`}
      href="/contact">Contact</a
    >
  </div>
  <div class="sm:hidden pl-4">
    <Sandwich currentPath={currentPath} />
  </div>
  <div class="ml-auto sm:ml-5"><ThemeToggle /></div>
</NavCard>
