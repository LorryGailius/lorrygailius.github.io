---
import ThemeToggle from "./ThemeToggle.astro";

const btnStyle = "button hover font-bold text-black bg-white border-2 border-black shadow-[4px_4px_0px_0px_#000] hover:shadow-[6px_6px_0px_0px_#000] transition-all duration-200 px-4 py-2 uppercase tracking-wide";
---

<div class="flex items-center px-1 py-4 sm:p-4 gap-3">
    <button class={btnStyle}>
        About
    </button>
    <button class={btnStyle}>
        Projects
    </button>
    <button class={btnStyle}>
        Contact
    </button>
    <div class="sm:flex-grow hidden sm:flex"/>
    <ThemeToggle />
</div>