---
import MainHead from "./MainHead.astro";
import "../styles/globals.css";
import NavBar from "../components/NavBar.astro";

const { title, seoTitle, seoDesc } = Astro.props;
---

<!doctype html>
<html lang="en">
  <MainHead title={title} seoTitle={seoTitle} seoDesc={seoDesc} />
  <body class="bg-white dark:bg-slate-700 px-4 font-mono">
    <header>
      <NavBar/>
    </header>
    <main class="min-h-screen">
      <slot />
    </main>
    <footer class="mt-8">
      <div class="box bg-neon-pink text-black font-bold p-6 text-center border-4 border-black">
        <p class="text-xl mb-4 uppercase tracking-wide">GET IN TOUCH</p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href="mailto:contact@lorrygailius.dev" class="button hover font-bold text-black bg-white border-2 border-black shadow-brutal hover:shadow-brutal-lg transition-all duration-200 px-4 py-2 uppercase tracking-wide">
            EMAIL
          </a>
          <a href="https://github.com/LorryGailius" class="button hover font-bold text-black bg-white border-2 border-black shadow-brutal hover:shadow-brutal-lg transition-all duration-200 px-4 py-2 uppercase tracking-wide">
            GITHUB
          </a>
          <a href="https://linkedin.com/in/laurynas-gailius" class="button hover font-bold text-black bg-white border-2 border-black shadow-brutal hover:shadow-brutal-lg transition-all duration-200 px-4 py-2 uppercase tracking-wide">
            LINKEDIN
          </a>
        </div>
        <p class="mt-4 text-sm">© 2024 LAURYNAS GAILIUS - BUILT WITH ASTRO & LOTS OF ☕</p>
      </div>
    </footer>
  </body>
</html>
