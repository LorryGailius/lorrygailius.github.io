---
import { SEO } from "astro-seo";
import Themes from "astro-themes";
const { title, seoTitle, seoDesc } = Astro.props;
---

<head>
  <title>{title}</title>
  <SEO
    title={seoTitle}
    description={seoDesc}
    openGraph={{
      basic: {
        title: seoTitle,
        type: "website",
        image: "https://lorrygailius.github.io/preview.png",
        url: "https://lorrygailius.github.io",
      },
      optional: {
        description: seoDesc,
      },
    }}
    extend={{
      link: [
        { rel: "icon", href: "/icon.ico" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
      ],
    }}
  />
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Themes />
</head>
