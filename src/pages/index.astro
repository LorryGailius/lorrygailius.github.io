---
import Contacts from "../components/Contacts.astro";
import IntroCard from "../components/IntroCard.astro";
import ProjectsCard from "../components/ProjectsCard.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { featured } from "../lib/featured.ts";

const projects = (await getCollection("projects"))
  .filter((project) => featured.includes(project.data.title))
  .slice(0, 2);
---

<MainLayout
  title="Laurynas Gailius Portfolio Page"
  seoTitle="Laurynas Gailius, Software Engineer Portfolio"
  seoDesc="Software Engineer looking to start his career in the IT world with deep focus on fullstack programming"
>
  <main
    class="m-auto mt-3 sm:mt-auto grid gap-4 max-w-2xl relative px-4 sm:px-0 sm:gap-4 md:gap-5 md:grid-cols-3 lg:gap-6 flex-auto"
  >
    <IntroCard />
    <Contacts />
    <ProjectsCard title="Featured Projects" projects={projects} />
  </main>
</MainLayout>
