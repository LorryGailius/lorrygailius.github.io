---
import { getCollection } from "astro:content";
import HeroSection from "../components/content/HeroSection.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { featured } from "../lib/featured";
import Projects from "../components/content/Projects.astro";

const projects = (await getCollection("projects"))
  .filter((project) => featured.includes(project.data.title))
  .slice(0, 2);
---

<MainLayout
  title="Laurynas Gailius Portfolio Page"
  seoTitle="Laurynas Gailius, Software Engineer Portfolio"
  seoDesc="Software Engineer looking to start his career in the IT world with deep focus on fullstack programming"
>
  <HeroSection/>
  <div class="marquee bg-red-400 text-black font-bold text-2xl py-4 border-y-4 border-black">
    <div class="marquee-content">
      <span>SOFTWARE ENGINEER</span>
      <span>FULL-STACK DEVELOPER</span>
      <span>PROBLEM SOLVER</span>
      <span>CODE ENTHUSIAST</span>
      <span>TECH INNOVATOR</span>
      <span>SOFTWARE ENGINEER</span>
      <span>FULL-STACK DEVELOPER</span>
    </div>
  </div>
  <Projects projects={projects} title="Featured Projects" />
</MainLayout>
